   "items": [
    {
     "name": "Belle Amie Bistro",
     "descriptionHtml": "Welcome to Belle Amie Bistro, a cozy and elegant retreat from the city's hustle. Whether you are starting your day with a vibrant breakfast, joining us for a business lunch, or enjoying a romantic dinner, we invite you to experience world-class cuisine served with the warm and attentive care of our team.&nbsp;<br><p><br></p><p><br></p><p>Opening Hours:</p><p>Breakfast: 06:00 – 10:00</p><p>All-Day Dining: 11:00 – 22:30&nbsp;</p>",
